const RAW_ROWS = CES_DATASET.rows;
const GENERATED_AT = new Date(CES_DATASET.generatedAt);
const TODAY = new Date();

const MESES = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
const MONTH_ORDER = MESES; // mesma ordem cronológica

function parseLocalDate(iso){
  if(!iso) return null;
  const [y,m,d] = iso.split('-').map(Number);
  return new Date(y, m-1, d);
}

function fmtDateTime(d){
  return d.toLocaleString('pt-BR', {day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit'});
}
function fmtDate(d){
  return d.toLocaleDateString('pt-BR', {day:'2-digit', month:'2-digit', year:'numeric'});
}
function fmtPct(v){ return v==null ? '—' : v.toFixed(1).replace('.', ',') + '%'; }
function fmtNum(v, dec){ return v==null ? '—' : v.toFixed(dec==null?2:dec).replace('.', ','); }

// ---------- Deriva campos calculados de cada linha ----------
const ALL_ROWS = RAW_ROWS.map(r => {
  const dataEnvioDate = parseLocalDate(r.dataEnvio);
  const dataEnvioMidnight = dataEnvioDate ? new Date(dataEnvioDate.getFullYear(), dataEnvioDate.getMonth(), dataEnvioDate.getDate()) : null;
  const hojeMidnight = new Date(TODAY.getFullYear(), TODAY.getMonth(), TODAY.getDate());
  const futuro = dataEnvioMidnight ? dataEnvioMidnight > hojeMidnight : false;
  const mesElegivel = dataEnvioDate ? MESES[dataEnvioDate.getMonth()] : null;
  const respondeu = !!(r.respForm || r.respWpp);
  const canal = (r.respForm && r.respWpp) ? 'Ambos' : (r.respForm ? 'Formulário' : (r.respWpp ? 'WhatsApp' : null));
  const mesRespostaNome = r.mesResposta ? MESES[r.mesResposta - 1] : null;
  let media = null;
  if(r.mediaForm != null && r.mediaWpp != null) media = (r.mediaForm + r.mediaWpp) / 2;
  else if(r.mediaForm != null) media = r.mediaForm;
  else if(r.mediaWpp != null) media = r.mediaWpp;
  return Object.assign({}, r, { dataEnvioDate, futuro, mesElegivel, respondeu, canal, mesRespostaNome, media });
});

