function getFiltrosGeral(){
  return {
    mes: document.getElementById('vg-filtro-mes').value,
    negocio: document.getElementById('vg-filtro-negocio').value.trim().toLowerCase(),
  };
}
function limparFiltrosGeral(){
  document.getElementById('vg-filtro-mes').value = '';
  document.getElementById('vg-filtro-negocio').value = '';
  renderGeral();
}
function getRowsFiltradas(){
  const { mes, negocio } = getFiltrosGeral();
  return ALL_ROWS.filter(r => {
    if(mes && r.mesElegivel !== mes) return false;
    if(negocio && !(r.negocio || '').toLowerCase().includes(negocio)) return false;
    return true;
  });
}

function computeAggregates(rows){
  const eligRows = rows.filter(r => r.dataEnvioDate && !r.futuro);
  const respondedRows = eligRows.filter(r => r.respondeu);

  const totalElig = eligRows.length;
  const totalResp = respondedRows.length;
  const formCount = eligRows.filter(r => r.respForm).length;
  const wppCount = eligRows.filter(r => r.respWpp).length;
  const bothCount = eligRows.filter(r => r.respForm && r.respWpp).length;
  const taxa = totalElig ? (totalResp / totalElig * 100) : null;

  const withMedia = respondedRows.filter(r => r.media != null);
  const mediaGeral = withMedia.length ? withMedia.reduce((a, r) => a + r.media, 0) / withMedia.length : null;

  const byMonth = MONTH_ORDER.map(m => {
    const me = eligRows.filter(r => r.mesElegivel === m);
    if(!me.length) return null;
    const mr = me.filter(r => r.respondeu);
    return {
      mes: m,
      elig: me.length,
      form: me.filter(r => r.respForm).length,
      wpp: me.filter(r => r.respWpp).length,
      total: mr.length,
      taxa: me.length ? (mr.length / me.length * 100) : null,
    };
  }).filter(Boolean);

  const dims = [
    {key: 'q1', label: 'Contrato'},
    {key: 'q2', label: 'Integração'},
    {key: 'q3', label: '1ª Coleta'},
    {key: 'q4', label: 'Painel'},
    {key: 'q5', label: 'Rotina'},
  ];
  const cats = ['Very Difficult', 'Difficult', 'Neutral', 'Easy', 'Very Easy'];
  const heat = dims.map(d => {
    const vals = {}; cats.forEach(c => vals[c] = 0);
    let base = 0;
    eligRows.forEach(r => { const v = r[d.key]; if(v && cats.includes(v)){ vals[v]++; base++; } });
    return {dim: d.label, vals, base};
  });

  const tiers = ['Platinum', 'Gold', 'Black'];
  const tierRows = tiers.map(t => {
    const te = eligRows.filter(r => r.tier === t);
    const tr = te.filter(r => r.respondeu);
    const tm = tr.filter(r => r.media != null);
    return {
      tier: t, elig: te.length, resp: tr.length,
      taxa: te.length ? (tr.length / te.length * 100) : null,
      media: tm.length ? tm.reduce((a, r) => a + r.media, 0) / tm.length : null,
    };
  });

  const mesRespMap = {};
  respondedRows.forEach(r => {
    if(r.mesRespostaNome && r.media != null){
      (mesRespMap[r.mesRespostaNome] = mesRespMap[r.mesRespostaNome] || []).push(r.media);
    }
  });
  const mediaPorMes = MONTH_ORDER.map(m => mesRespMap[m] ? {
    mes: m, n: mesRespMap[m].length, media: mesRespMap[m].reduce((a, b) => a + b, 0) / mesRespMap[m].length,
  } : null).filter(Boolean);

  const formMedias = eligRows.filter(r => r.respForm && r.mediaForm != null).map(r => r.mediaForm);
  const wppMedias = eligRows.filter(r => r.respWpp && r.mediaWpp != null).map(r => r.mediaWpp);
  const mediaCanal = {
    form: formMedias.length ? {n: formMedias.length, media: formMedias.reduce((a, b) => a + b, 0) / formMedias.length} : null,
    wpp: wppMedias.length ? {n: wppMedias.length, media: wppMedias.reduce((a, b) => a + b, 0) / wppMedias.length} : null,
  };

  return {totalElig, totalResp, formCount, wppCount, bothCount, taxa, mediaGeral, byMonth, heat, tierRows, mediaPorMes, mediaCanal};
}

function heroCardHtml(label, value, note){
  return `<div class="hero-kpi-card">
    <div class="hero-kpi-card-label">${label}</div>
    <div class="hero-kpi-card-value">${value}</div>
    <div class="hero-kpi-card-note">${note}</div>
  </div>`;
}

function renderGeral(){
  const filtros = getFiltrosGeral();
  const filtered = getRowsFiltradas();
  const agg = computeAggregates(filtered);
  const filtroAtivo = !!(filtros.mes || filtros.negocio);

  document.getElementById('vg-filter-status').textContent = filtroAtivo
    ? `Filtro ativo — mostrando ${filtered.length} de ${ALL_ROWS.length} negócios`
    : '';

  const hojeStr = fmtDate(TODAY);
  document.getElementById('hero-kpi-grid').innerHTML = [
    heroCardHtml('Elegíveis' + (filtros.mes ? ` (${filtros.mes})` : ''), agg.totalElig,
      `Considera só quem já recebeu a pesquisa até ${hojeStr}`),
    heroCardHtml('Respostas Únicas', agg.totalResp, 'Por negócio — sem duplicar quem respondeu 2x'),
    heroCardHtml('Taxa de Resposta', fmtPct(agg.taxa), `${agg.totalResp} respostas / ${agg.totalElig} elegíveis`),
    heroCardHtml('Via Formulário', agg.formCount, `${agg.bothCount} responderam pelos dois canais`),
    heroCardHtml('Via WhatsApp', agg.wppCount, 'Canal Treble · pergunta única (Rotina)'),
    heroCardHtml('Média CES Geral', fmtNum(agg.mediaGeral), 'Escala 1 (Very Difficult) – 5 (Very Easy)'),
  ].join('');

  document.getElementById('funil-helper').textContent = filtroAtivo
    ? 'Funil recalculado para o filtro selecionado. "Mês elegível" é o mês em que o negócio ficou elegível; as respostas contam independentemente do mês em que chegaram.'
    : 'Elegíveis considera apenas negócios que já receberam a pesquisa até hoje. Cada linha soma todas as respostas daquele grupo, mesmo as recebidas em um mês posterior.';
  document.getElementById('funil-periodo').textContent = agg.byMonth.length ? `${agg.byMonth[0].mes}–${agg.byMonth[agg.byMonth.length-1].mes} 2026` : '—';

  const funilBody = document.getElementById('funil-body');
  if(agg.byMonth.length === 0){
    funilBody.innerHTML = `<tr><td colspan="6" class="empty-state">Nenhum negócio elegível para este filtro.</td></tr>`;
  } else {
    funilBody.innerHTML = agg.byMonth.map(m => `
      <tr>
        <td>${m.mes}</td>
        <td class="right-align">${m.elig}</td>
        <td class="right-align ${m.form ? '' : 'kpi-num-dash'}">${m.form}</td>
        <td class="right-align ${m.wpp ? '' : 'kpi-num-dash'}">${m.wpp}</td>
        <td class="right-align">${m.total}</td>
        <td class="right-align">${fmtPct(m.taxa)}</td>
      </tr>
    `).join('') + `
      <tr class="row-total">
        <td>Total</td>
        <td class="right-align">${agg.totalElig}</td>
        <td class="right-align">${agg.formCount}</td>
        <td class="right-align">${agg.wppCount}</td>
        <td class="right-align">${agg.totalResp}</td>
        <td class="right-align">${fmtPct(agg.taxa)}</td>
      </tr>`;
  }

  document.getElementById('heatmap-periodo').textContent = filtroAtivo ? 'Filtro ativo' : 'Todo o período elegível';
  const cats = ['Very Difficult', 'Difficult', 'Neutral', 'Easy', 'Very Easy'];
  document.getElementById('heatmap-body').innerHTML = agg.heat.map(row => {
    let html = `<td style="font-weight:600;">${row.dim}</td>`;
    cats.forEach(c => {
      const v = row.vals[c] || 0;
      const pct = row.base ? v / row.base : 0;
      const bg = heatColorFor(pct);
      const fg = pct > 0.55 ? '#fff' : '#111827';
      const pctLabel = row.base ? Math.round(pct * 100) + '%' : '—';
      html += `<td><div class="heat-cell" style="background:${bg}; color:${fg};">${v}<span class="heat-pct" style="color:${fg}; opacity:0.85;">${pctLabel}</span></div></td>`;
    });
    html += `<td class="right-align" style="color:var(--muted);">${row.base}</td>`;
    return `<tr>${html}</tr>`;
  }).join('') || `<tr><td colspan="7" class="empty-state">Sem respostas para este filtro.</td></tr>`;

  document.getElementById('tier-periodo').textContent = filtroAtivo ? 'Filtro ativo' : 'Todo o período elegível';
  document.getElementById('tier-body').innerHTML = agg.tierRows.map(t => `
    <tr>
      <td>${tierBadge(t.tier)}</td>
      <td class="right-align">${t.elig}</td>
      <td class="right-align">${t.resp}</td>
      <td class="right-align">${fmtPct(t.taxa)}</td>
      <td class="right-align">${fmtNum(t.media)}</td>
    </tr>
  `).join('') + `
    <tr class="row-total">
      <td>Total</td>
      <td class="right-align">${agg.totalElig}</td>
      <td class="right-align">${agg.totalResp}</td>
      <td class="right-align">${fmtPct(agg.taxa)}</td>
      <td class="right-align">${fmtNum(agg.mediaGeral)}</td>
    </tr>`;

  const mediaMesEl = document.getElementById('media-mes-body');
  mediaMesEl.innerHTML = agg.mediaPorMes.length ? agg.mediaPorMes.map(m => `
    <div class="month-avg-row">
      <div class="month-avg-label">${m.mes}</div>
      <div class="month-avg-bar"><div class="bar-track"><div class="bar-fill" style="width:${Math.min(m.media/5*100,100)}%;"></div></div></div>
      <div class="month-avg-value">${fmtNum(m.media)}</div>
    </div>
  `).join('') : `<div class="empty-state">Sem respostas para este filtro.</div>`;

  const mediaCanalEl = document.getElementById('media-canal-body');
  const mc = agg.mediaCanal;
  mediaCanalEl.innerHTML = (mc.form || mc.wpp) ? `
    ${mc.form ? `<div class="month-avg-row">
      <div class="month-avg-label">Formulário</div>
      <div class="month-avg-bar"><div class="bar-track"><div class="bar-fill" style="width:${Math.min(mc.form.media/5*100,100)}%;"></div></div></div>
      <div class="month-avg-value">${fmtNum(mc.form.media)}</div>
    </div>` : ''}
    ${mc.wpp ? `<div class="month-avg-row">
      <div class="month-avg-label">WhatsApp</div>
      <div class="month-avg-bar"><div class="bar-track"><div class="bar-fill" style="width:${Math.min(mc.wpp.media/5*100,100)}%; background:#60a5fa;"></div></div></div>
      <div class="month-avg-value">${fmtNum(mc.wpp.media)}</div>
    </div>` : ''}
  ` : `<div class="empty-state">Sem respostas para este filtro.</div>`;

  document.getElementById('metodologia-footnote').innerHTML =
    `Metodologia: dados extraídos da aba <em>Resumo por Negócio v2</em> (uma linha por negócio), com remoção de duplicatas exatas. Uma resposta é contada uma única vez por negócio mesmo quando ele respondeu pelo Formulário e pelo WhatsApp — nesse caso, a média combinada é a média das duas notas. "Elegíveis" considera apenas negócios cuja data de envio da pesquisa já ocorreu (≤ ${hojeStr}); negócios com data futura ainda não entram no cálculo e aparecem na aba Consulta por Cliente como "Aguardando envio". Cada linha do funil soma todas as respostas do grupo, independentemente do mês em que a resposta foi registrada. Escala CES: Very Difficult=1, Difficult=2, Neutral=3, Easy=4, Very Easy=5. Use os filtros de mês e negócio acima para recalcular todos os painéis desta aba.`;
}

function heatColorFor(pct){
  const stops = [
    {p:0,    c:[239,246,255]},
    {p:0.25, c:[191,219,254]},
    {p:0.5,  c:[96,165,250]},
    {p:0.75, c:[37,99,235]},
    {p:1,    c:[15,27,69]},
  ];
  let lo = stops[0], hi = stops[stops.length - 1];
  for(let i = 0; i < stops.length - 1; i++){
    if(pct >= stops[i].p && pct <= stops[i+1].p){ lo = stops[i]; hi = stops[i+1]; break; }
  }
  const range = hi.p - lo.p || 1;
  const t = (pct - lo.p) / range;
  const c = lo.c.map((v, i) => Math.round(v + (hi.c[i] - v) * t));
  return `rgb(${c[0]},${c[1]},${c[2]})`;
}
function tierBadge(tier){
  const map = {'Gold': 'tier-gold', 'Platinum': 'tier-platinum', 'Black': 'tier-black'};
  const cls = map[tier] || 'tier-none';
  return `<span class="tier-badge ${cls}">${tier || '—'}</span>`;
}

function populateVgFiltros(){
  const meses = [...new Set(ALL_ROWS.filter(r => r.mesElegivel).map(r => r.mesElegivel))]
    .sort((a, b) => MESES.indexOf(a) - MESES.indexOf(b));
  const mesSel = document.getElementById('vg-filtro-mes');
  meses.forEach(m => { const o = document.createElement('option'); o.value = m; o.textContent = m; mesSel.appendChild(o); });

  const negocios = [...new Set(ALL_ROWS.map(r => r.negocio).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
  const dl = document.getElementById('vg-negocios-list');
  dl.innerHTML = negocios.map(n => `<option value="${escapeHtml(n)}"></option>`).join('');

  const mesSelConsulta = document.getElementById('filtro-mes');
  meses.forEach(m => { const o = document.createElement('option'); o.value = m; o.textContent = m; mesSelConsulta.appendChild(o); });
}

// ================= CONSULTA POR CLIENTE =================
function statusBadge(r){
  if(r.futuro) return '<span class="status-badge status-futuro">Aguardando envio</span>';
  return r.respondeu
    ? '<span class="status-badge status-sim">Sim</span>'
    : '<span class="status-badge status-nao">Não</span>';
}
function renderConsulta(){
  const busca = document.getElementById('filtro-busca').value.trim().toLowerCase();
  const mes = document.getElementById('filtro-mes').value;
  const status = document.getElementById('filtro-status').value;

  const filtered = ALL_ROWS.filter(r => {
    if(busca && !(r.negocio || '').toLowerCase().includes(busca)) return false;
    if(mes && r.mesElegivel !== mes) return false;
    if(status === 'sim' && !r.respondeu) return false;
    if(status === 'nao' && (r.respondeu || r.futuro)) return false;
    if(status === 'futuro' && !r.futuro) return false;
    return true;
  }).sort((a, b) => (a.negocio || '').localeCompare(b.negocio || '', 'pt-BR'));

  document.getElementById('consulta-count').textContent = `Mostrando ${filtered.length} de ${ALL_ROWS.length} negócios`;

  const tbody = document.getElementById('consulta-body');
  if(filtered.length === 0){
    tbody.innerHTML = `<tr><td colspan="8" class="no-results">Nenhum negócio encontrado.</td></tr>`;
    return;
  }
  tbody.innerHTML = filtered.map(r => `
    <tr>
      <td style="font-weight:600;">${escapeHtml(r.negocio || '—')}</td>
      <td>${tierBadge(r.tier)}</td>
      <td>${r.mesElegivel || '—'}</td>
      <td>${statusBadge(r)}</td>
      <td>${r.canal || '<span class="kpi-num-dash">—</span>'}</td>
      <td>${r.mesRespostaNome || '<span class="kpi-num-dash">—</span>'}</td>
      <td class="right-align">${r.media != null ? fmtNum(r.media) : '<span class="kpi-num-dash">—</span>'}</td>
      <td class="comentario-cell">${r.comentario ? escapeHtml(r.comentario) : '<span class="kpi-num-dash">—</span>'}</td>
    </tr>
  `).join('');
}
function escapeHtml(str){
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

// ================= TABS =================
function switchTab(view){
  document.querySelectorAll('.page-tabs button').forEach(b => b.classList.toggle('active', b.dataset.view === view));
  document.querySelectorAll('.view').forEach(v => v.classList.toggle('active', v.id === 'view-' + view));
}

// ================= INIT =================
function updateRefreshBadge(){
  document.getElementById('refresh-badge').innerHTML =
    `Dados de <b>${fmtDateTime(GENERATED_AT)}</b> · peça para atualizar quando quiser`;
  document.getElementById('consulta-helper').textContent =
    `Busque um negócio pelo nome ou filtre por mês de elegibilidade e status de resposta. Base: ${ALL_ROWS.length} negócios. Dados de ${fmtDateTime(GENERATED_AT)}.`;
}

populateVgFiltros();
updateRefreshBadge();
renderGeral();
renderConsulta();
</script>

